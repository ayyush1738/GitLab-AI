# ─────────────────────────────────────────────────────────────────────────────
# SafeConfig AI — Production Environment Template
# Copy this to .env for local dev, or set via GCP Secret Manager for Cloud Run
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-secret-key
# Set to 'production' on Cloud Run. Controls: cookie_secure, debug mode,
# OAUTHLIB_INSECURE_TRANSPORT removal.
FLASK_ENV=production

# ── Database (Cloud SQL via public IP or Cloud SQL Auth Proxy) ────────────────
# Local dev:    postgresql://postgres:password@127.0.0.1:5432/gitguardian
# Cloud Run:    postgresql+psycopg2://user:pass@/dbname?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/gitguardian

# ── Redis (Cloud Memorystore) ─────────────────────────────────────────────────
# Local dev:    redis://127.0.0.1:6379/0
# Cloud Run:    redis://10.x.x.x:6379/0  (VPC connector required)
REDIS_URL=redis://127.0.0.1:6379/0

# ── GitLab OAuth Application ──────────────────────────────────────────────────
GITLAB_ID=your-gitlab-application-id
GITLAB_SECRET=your-gitlab-application-secret

# ── Domain Unity (THE most critical variables) ────────────────────────────────
# BASE_URL: the public URL of THIS Flask backend.
#   Local dev:  http://127.0.0.1:5000
#   Cloud Run:  https://safeconfig-ai-<hash>-uc.a.run.app
# This value MUST exactly match the Redirect URI registered in your GitLab OAuth App.
BASE_URL=http://127.0.0.1:5000

# FRONTEND_URL: the public URL of the Next.js frontend (used for CORS + post-login redirect).
#   Local dev:  http://127.0.0.1:3000
#   Vercel:     https://safeconfig-ai.vercel.app
FRONTEND_URL=http://127.0.0.1:3000

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=judge@safeconfig.ai

# ── AI APIs ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-claude-key
GROQ_API_KEY=your-groq-key
GOOGLE_API_KEY=your-google-api-key
GOOGLE_APPLICATION_CREDENTIALS=./google-creds.json

# ── Cloud Run ─────────────────────────────────────────────────────────────────
# Cloud Run injects PORT automatically (usually 8080). No need to set this
# manually in production — only override for local docker testing.
# PORT=8080
